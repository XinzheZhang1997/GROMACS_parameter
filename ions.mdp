integrator      = steep     ; 
nsteps          = 50        ; 
emtol           = 1000.0    ; 

cutoff-scheme   = Verlet    ; 
vdw-modifier    = Potential-shift ; 
rlist           = 1.2       ; 
rcoulomb        = 1.2       ; 
rvdw            = 1.2       ; 
coulombtype     = PME       ; 
fourierspacing  = 0.12      ; 
pme-order       = 4         ; 

tcoupl          = no        ; 
pcoupl          = no        ; 

nstxout         = 0         ; 
nstenergy       = 1         ; 
nstlog          = 1         ; 
